# Backend FastAPI (mismo que usan frontend-web y frontend-backoffice)
BACKEND_API_URL=http://localhost:8098
# Gate de aplicación del backend (X-Finmotor-Service-Key)
FINMOTOR_SERVICE_KEY=
# Secreto interno del backend (X-Finmotor-Backend-Secret) — sólo para llamadas sin usuario
FINMOTOR_BACKEND_SECRET=

# Origenes usados por la CSP / next/image
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9098
NEXT_PUBLIC_API_ORIGIN=http://localhost:8098

NEXT_PUBLIC_APP_URL=http://localhost:3002
WEB_APP_URL=http://localhost:3000
